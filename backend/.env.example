# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (servicio `db` de compose.yaml; levántalo con `make db-up`)
DB_HOST=127.0.0.1
DB_PORT=54410
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_dev

# Rol de solo lectura `flowsync_ro` sobre la base de desarrollo, para agentes.
# No lo usa la aplicación: lo lee `make db-readonly` al crear o actualizar el rol.
# Cámbiala en tu .env.
DB_RO_PASSWORD=cambia-esta-clave-ro
